    {
      "id": "kbv2-bc1bb791",
      "begrip": "Ondersteuningsplan",
      "lade": null,
      "status": "draft",
      "lagen": {
        "laag1": "Een ondersteuningsplan is een schriftelijk document dat de individuele ondersteuningsbehoeften, doelen, interventies en evaluatiemomenten van een cliënt vastlegt. Het wordt samen met de cliënt en betrokkenen opgesteld en periodiek geëvalueerd.",
        "laag2": "Kerncomponenten: (1) Inventarisatie van huidige situatie en behoeften, (2) SMART-geformuleerde doelen, (3) Concrete activiteiten en methodieken, (4) Evaluatiecriteria en -momenten, (5) Betrokkenen (cliënt, familie, multidisciplinair team). Cruciaal voor cliëntgerichte zorg en communicatie binnen het zorgteam.",
        "laag3": "",
        "laag4": ""
      },
      "ws5": {},

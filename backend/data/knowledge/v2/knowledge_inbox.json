      "id": "kbv2-f956a707",
      "begrip": "Werkprocessen MBO Persoonlijk Begeleider",
      "lade": null,
      "status": "draft",
      "lagen": {
        "laag1": "Het MBO-kwalificatiedossier Persoonlijk Begeleider Specifieke Doelgroepen kent twee basis-kerntaken (B1-K1: begeleiding cliënt / B1-K2: kwaliteit) en één profiel-kerntaak (P6-K1: coördinerende taken). Elke kerntaak heeft meerdere werkprocessen (W1..W9).",
        "laag2": "Voorbeelden: B1-K1-W1 (inventariseren ondersteuningsvragen), B1-K1-W2 (persoonlijke verzorging), B1-K1-W3 (wonen/huishouden), B1-K1-W4 (dagbesteding), B1-K1-W6 (werkzaamheden afstemmen), B1-K1-W7 (ondersteuning evalueren), P6-K1-W5 (coördineren dagelijkse gang van zaken).",
        "laag3": "",
        "laag4": ""
      },

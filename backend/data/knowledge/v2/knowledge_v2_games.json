    {
      "id": "kbv2-c5847d4a",
      "begrip": "Base Line",
      "lade": "games",
      "status": "active",
      "lagen": {
        "laag1": "Base Line is de basiskaart van Spark World: het nulpunt (X=0, Y=0, Z=0) waar alle basiswaarden van de wereld vandaan komen.",
        "laag2": "Basiswaarden:\n\n- Oorsprong: (0, 0, 0), wereld is 3D en groeit onbegrensd\n- Tijdrekening: AD (After Spark), jaar 0 = Base Line\n- Balans licht/schaduw: standaard 50/50 van het oppervlak\n- Elementen: lucht, water, aarde, vuur\n- Fracties: Spark, Players, Licht, Schaduw (2 elementen + versterker licht of schaduw = fractie)\n- Startinventory: 4 slots + 10 kg (zie Persoonskaart Rugzak)",
        "laag3": "Elke waarde in Spark World wordt relatief aan Base Line gemeten: afstand vanaf (0,0,0), tijd sinds AD 0 en de licht/schaduw-verhouding per gebied. Verschuift de balans (bv. 2/3 schaduw), dan weegt dat oppervlak zwaarder in het volume.",
        "laag4": "Base Line is de plek om nieuwe basiswaarden toe te voegen (economie, XP-curves, grondstofprijzen) zodat alle game-modules één bron van waarheid delen. De oude oorsprongs-lore staat gearchiveerd in data/dnd/lore_index.json."
      },
      "ws5": {
        "wat": "De basiswaarden-kaart van Spark World.",
        "wie": "Alle game-modules en spelers gebruiken deze waarden.",
        "waar": "Nulpunt (0,0,0) van de Spark World-kaart.",
        "wanneer": "AD 0 — en bij elke nieuwe basiswaarde.",
        "waarom": "Eén bron van waarheid voor coördinaten, tijd, balans, fracties en startwaarden.",
        "hoe": "Waarden hier vastleggen; modules (steden, fracties, inventory) verwijzen ernaar."
      },

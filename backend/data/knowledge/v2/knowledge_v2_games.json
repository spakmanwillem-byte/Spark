    {
      "id": "kbv2-5ae16b66",
      "begrip": "Spark World",
      "lade": "games",
      "status": "active",
      "lagen": {
        "laag1": "Spark World is Spark's eigen sandbox-game: een levende wereld die groeit door keuzes en interpretatie van spelers.",
        "laag2": "Geen klassiek RPG met vaste regels. Stats ontstaan uit gedrag, lore ontstaat uit ervaring. De wereld is gebouwd op de kaart van Nederland met fictieve steden (Oerrak, Lumis, Umbros, Asher, Breez, Extros, Grondheim, Eikenhart) en één neutrale stad: Utrecht. Fracties: Spark, Players, Licht en Schaduw.",
        "laag3": "Bouwstenen: Base Line (basiswaarden), Persoonskaart met inventory (Rugzak), grondstoffen en gebieden (bos, akkers, vis, mijn, haven), fracties en steden. Losse module-games zoals Steen Papier Schaar kunnen gekoppeld worden, bv. als gevechtsmechaniek met een eigen scorelijst.",
        "laag4": "Status: geparkeerd tot Spark Core klaar is. Data leeft in de dnd-container (data/dnd/: steden, fracties, characters, blueprints, world_state). Eerder liepen de namen D&D, dnd en d&d door elkaar; de universele naam is nu Spark World."
      },
      "ws5": {
        "wie": "Spelers, bots en Spark zelf.",
        "wat": "Spark's sandbox-game: een levende wereld.",
        "wanneer": "Geparkeerd; oppakken na Spark Core.",
        "waar": "Kennisbank → Spark Games + data/dnd container.",
        "waarom": "Spelen, groeien en betekenis maken uit ervaring.",
        "hoe": "Base Line-waarden + modules (steden, fracties, inventory, gekoppelde mini-games)."
      },

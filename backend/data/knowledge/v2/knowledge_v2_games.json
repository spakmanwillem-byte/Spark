    {
      "id": "kbv2-5cd66b24",
      "begrip": "Persoonskaart Rugzak",
      "lade": "games",
      "status": "active",
      "lagen": {
        "laag1": "Persoonskaart-rugzak = inventory-slot dat bonus draagkracht geeft (D&D-laag van Spark).",
        "laag2": "Elke speler en bot in Spark World heeft een Persoonskaart met inventory. Basis is 4 slots + 10kg. Een rugzak voegt slots én kg toe maar weegt zelf ook. Hoe groter de rugzak, hoe meer capaciteit — maar minder ruimte voor zware items.",
        "laag3": "Trade-off mechaniek: Basis Rugzak (+5 slots, +10kg, weegt 1kg) vs Grote Trekrugzak (+10 slots, +25kg, weegt 2.5kg). Inventory zit vol bij slots_used == slots_total OF weight_used > weight_max. Slimme spelers kiezen op speelstijl: light & snel of robuust & traag.",
        "laag4": "Inleiding op het body-slot-systeem dat later komt (helm, cape, schoenen, etc.). De rugzak is metafoor voor wat je dagelijks meeneemt — herinneringen, kennis, achievements. Eerste D&D-mechaniek in Spark."
      },
      "ws5": {
        "wat": "Een D&D body-slot dat bonus-slots + bonus-kg toevoegt aan iemands inventory.",
        "wie": "Iedereen — speler en bot — krijgt automatisch een Basis Rugzak (starter pack).",
        "waar": "Profiel → Avatar-tab → Persoonskaart sectie.",
        "wanneer": "Bij gebruiker-aanmaak. Upgrades verdiend via XP, achievements, of shop.",
        "waarom": "Eerste progression-mechaniek met expliciete trade-off; introduceert spelers aan inventory-management.",
        "hoe": "Item.kind='carry' met capacity_bonus (extra slots) en weight_bonus (extra kg). Eigen weight telt mee."
      },

  "voorwaarden_template": {
    "version": "v1",
    "kernzin": "Ik bevestig dat ik Spark als platform-partner accepteer en 2% van de netto-winst maandelijks afdraag voor onderhoud, beschikbaarheid en doorontwikkeling van Spark Core.",
    "artikelen": [
      {
        "nr": 1,
        "titel": "Spark-commissie",
        "tekst": "Spark ontvangt 2% van de netto-winst per kalendermaand. Netto-winst = omzet minus directe inkoopkosten en aantoonbare verzendkosten. Snapshot per 1e van de maand."
      },
      {
        "nr": 2,
        "titel": "Eigenaarschap & toegang",
        "tekst": "Alleen de owner_user_id heeft beheer-toegang tot eigen shop-data, producten, orders en statistieken. Andere users hebben alleen lees-toegang tot publieke producten."
      },
      {
        "nr": 3,
        "titel": "Verantwoordelijkheid",
        "tekst": "Owner is volledig verantwoordelijk voor productinhoud, fiscale aangifte, verzending en klantcontact. Spark levert het platform; geen juridische tussenpersoon."
      },
      {
        "nr": 4,
        "titel": "Gradatie-eis",
        "tekst": "Openen van een eigen winkel vereist gradatie 4 of hoger. Hiermee is voldoende vertrouwen opgebouwd in het systeem."
      },
      {
        "nr": 5,
        "titel": "Beëindiging",
        "tekst": "Owner kan op elk moment een verzoek tot sluiting indienen. Producten worden gearchiveerd, openstaande orders worden afgehandeld, en openstaande commissie wordt verrekend."
      }
    ]
  }

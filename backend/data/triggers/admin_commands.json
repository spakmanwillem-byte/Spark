{
  "admin_say_command": {
    "description": "Laat Spark een specifieke tekst zeggen (admin only - gradatie 1)",
    "patterns": [
      "spark zeg eens: [tekst]",
      "zeg eens: [tekst]"
    ],
    "examples": [
      "Spark zeg eens: Hallo allemaal!",
      "zeg eens: De trading bot draait perfect",
      "Spark zeg eens: Welkom bij Spark Core 4.1"
    ],
    "handler": "say_command",
    "gradatie_required": 1
  },
  "triggers_menu": {
    "description": "Beheer emotie trigger lijsten",
    "patterns": [
      "/triggers",
      "triggers",
      "trigger lijst",
      "trigger manager"
    ],
    "handler": "triggers_menu",
    "gradatie_required": 1
  },
  "triggers_view": {
    "description": "Bekijk een specifieke trigger lijst",
    "patterns": [
      "/triggers view [lijst]",
      "triggers view [a|b|c|d]"
    ],
    "examples": [
      "/triggers view a (blij)",
      "/triggers view b (boos)",
      "/triggers view c (bang)",
      "/triggers view d (bedroefd)"
    ],
    "handler": "triggers_view",
    "gradatie_required": 1
  },
  "triggers_move": {
    "description": "Verplaats een woord tussen trigger lijsten",
    "patterns": [
      "/triggers move [woord] van [emotie1] naar [emotie2]"
    ],
    "examples": [
      "/triggers move blij van a naar b"
    ],
    "handler": "triggers_move",
    "gradatie_required": 1
  },
  "triggers_remove": {
    "description": "Verwijder een woord uit een trigger lijst",
    "patterns": [
      "/triggers remove [woord] van [emotie]"
    ],
    "examples": [
      "/triggers remove test van a"
    ],
    "handler": "triggers_remove",
    "gradatie_required": 1
  },
  "metadata": {
    "purpose": "Admin-only commands voor platform management",
    "creator": "System",
    "version": "1.0",
    "last_updated": "2026-03-29T17:45:00Z",
    "note": "Alle commands vereisen gradatie 1 (admin) permissie"
  }
}

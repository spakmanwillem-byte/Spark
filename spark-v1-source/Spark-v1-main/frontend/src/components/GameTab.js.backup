import React, { useState, useEffect, useRef } from 'react';
import './GameTab.css';
import axios from 'axios';

const BACKEND_URL = process.env.REACT_APP_BACKEND_URL;
const API = `${BACKEND_URL}/api`;

const CELL_SIZE = 20;
const CANVAS_SIZE = 800;

function GameTab() {
  const [gameState, setGameState] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [selectedItem, setSelectedItem] = useState(null);
  const [buildMode, setBuildMode] = useState(false);
  const [isPaused, setIsPaused] = useState(false); // Game runs by default (active world)
  const canvasRef = useRef(null);

  const fetchGameState = async () => {
    try {
      const response = await axios.get(`${API}/game/state`);
      if (response.data.success) {
        setGameState(response.data.state);
        setError(null);
      }
    } catch (err) {
      console.error('[GAME] Error fetching state:', err);
      setError('Kon game state niet laden');
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchGameState();
  }, []);

  useEffect(() => {
    const interval = setInterval(() => {
      fetchGameState();
    }, 3000);
    return () => clearInterval(interval);
  }, []);

  // Keyboard controls - DISABLED (camera follows Spark)
  useEffect(() => {
    // Camera auto-follows, no manual control
  }, []);

  // FOG OF WAR RENDERING
  useEffect(() => {
    if (!gameState) return;

    const canvas = document.getElementById('game-canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const gridSize = gameState.grid_size;
    const isDay = gameState.game_time.is_day;
    const explored = new Set(gameState.explored_tiles?.map(t => `${t[0]},${t[1]}`) || []);

    // Calculate explored bounds
    let minX = gridSize, maxX = 0, minY = gridSize, maxY = 0;
    gameState.explored_tiles?.forEach(([x, y]) => {
      minX = Math.min(minX, x);
      maxX = Math.max(maxX, x);
      minY = Math.min(minY, y);
      maxY = Math.max(maxY, y);
    });

    const viewWidth = Math.max(40, maxX - minX + 10);
    const viewHeight = Math.max(40, maxY - minY + 10);
    
    const spark = gameState.spark;
    
    // Auto-follow Spark (always)
    const cameraX = Math.max(0, Math.min(gridSize - viewWidth, minX - 5));
    const cameraY = Math.max(0, Math.min(gridSize - viewHeight, minY - 5));

    // Clear to black
    ctx.fillStyle = '#000000';
    ctx.fillRect(0, 0, CANVAS_SIZE, CANVAS_SIZE);

    const visibleWidth = Math.min(viewWidth, Math.floor(CANVAS_SIZE / CELL_SIZE));
    const visibleHeight = Math.min(viewHeight, Math.floor(CANVAS_SIZE / CELL_SIZE));

    // Draw tiles
    for (let gx = 0; gx < visibleWidth; gx++) {
      for (let gy = 0; gy < visibleHeight; gy++) {
        const worldX = Math.floor(cameraX + gx);
        const worldY = Math.floor(cameraY + gy);
        const screenX = gx * CELL_SIZE;
        const screenY = gy * CELL_SIZE;
        
        const isExplored = explored.has(`${worldX},${worldY}`);
        
        if (isExplored) {
          ctx.fillStyle = isDay ? '#f5f5f5' : '#1a1a1a';
          ctx.fillRect(screenX, screenY, CELL_SIZE, CELL_SIZE);
          
          ctx.strokeStyle = isDay ? 'rgba(0, 0, 0, 0.05)' : 'rgba(255, 255, 255, 0.05)';
          ctx.strokeRect(screenX, screenY, CELL_SIZE, CELL_SIZE);
        } else {
          ctx.fillStyle = '#0a0a0a';
          ctx.fillRect(screenX, screenY, CELL_SIZE, CELL_SIZE);
        }
      }
    }

    // Draw water
    if (gameState.water_tiles) {
      gameState.water_tiles.forEach(water => {
        if (explored.has(`${water.x},${water.y}`)) {
          const screenX = (water.x - cameraX) * CELL_SIZE;
          const screenY = (water.y - cameraY) * CELL_SIZE;
          
          if (screenX >= 0 && screenX < CANVAS_SIZE && screenY >= 0 && screenY < CANVAS_SIZE) {
            ctx.fillStyle = '#4FC3F7';
            ctx.fillRect(screenX, screenY, CELL_SIZE, CELL_SIZE);
            
            ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';
            ctx.fillRect(screenX + 2, screenY + 2, CELL_SIZE - 4, CELL_SIZE / 3);
          }
        }
      });
    }

    // Draw monuments (3x3, always visible)
    if (gameState.monuments) {
      gameState.monuments.forEach(monument => {
        const mx = monument.x;
        const my = monument.y;
        const size = monument.size;
        
        // Always visible - ignore fog
        for (let dx = 0; dx < size; dx++) {
          for (let dy = 0; dy < size; dy++) {
            const screenX = (mx + dx - cameraX) * CELL_SIZE;
            const screenY = (my + dy - cameraY) * CELL_SIZE;
            
            if (screenX >= 0 && screenX < CANVAS_SIZE && screenY >= 0 && screenY < CANVAS_SIZE) {
              const progress = monument.progress;
              ctx.fillStyle = monument.color || '#FFD700';
              ctx.globalAlpha = 0.3 + (progress / 100) * 0.7;
              ctx.fillRect(screenX, screenY, CELL_SIZE, CELL_SIZE);
              ctx.globalAlpha = 1.0;
            }
          }
        }
        
        // Icon in center
        const centerX = (mx + 1 - cameraX) * CELL_SIZE + CELL_SIZE / 2;
        const centerY = (my + 1 - cameraY) * CELL_SIZE + CELL_SIZE / 2;
        
        if (centerX >= 0 && centerX < CANVAS_SIZE && centerY >= 0 && centerY < CANVAS_SIZE) {
          ctx.fillStyle = monument.color || '#FFD700';
          ctx.font = 'bold 24px Arial';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(monument.icon, centerX, centerY);
        }
      });
    }

    // Draw trees
    gameState.trees.forEach(tree => {
      if (explored.has(`${tree.x},${tree.y}`)) {
        const x = (tree.x - cameraX) * CELL_SIZE;
        const y = (tree.y - cameraY) * CELL_SIZE;

        if (x >= -CELL_SIZE && x < CANVAS_SIZE && y >= -CELL_SIZE && y < CANVAS_SIZE) {
          ctx.fillStyle = '#8B4513';
          ctx.fillRect(x + CELL_SIZE * 0.3, y + CELL_SIZE * 0.4, CELL_SIZE * 0.4, CELL_SIZE * 0.4);
          
          ctx.fillStyle = '#228B22';
          ctx.beginPath();
          ctx.arc(x + CELL_SIZE / 2, y + CELL_SIZE * 0.4, CELL_SIZE * 0.4, 0, 2 * Math.PI);
          ctx.fill();
        }
      }
    });

    // Draw stones
    gameState.stones.forEach(stone => {
      if (explored.has(`${stone.x},${stone.y}`)) {
        const x = (stone.x - cameraX) * CELL_SIZE;
        const y = (stone.y - cameraY) * CELL_SIZE;

        if (x >= -CELL_SIZE && x < CANVAS_SIZE && y >= -CELL_SIZE && y < CANVAS_SIZE) {
          ctx.fillStyle = '#808080';
          ctx.fillRect(x + CELL_SIZE * 0.2, y + CELL_SIZE * 0.2, CELL_SIZE * 0.6, CELL_SIZE * 0.6);
          
          ctx.fillStyle = '#A9A9A9';
          ctx.fillRect(x + CELL_SIZE * 0.3, y + CELL_SIZE * 0.3, CELL_SIZE * 0.3, CELL_SIZE * 0.3);
        }
      }
    });

    // Draw mountains (bergen)
    if (gameState.mountains) {
      gameState.mountains.forEach(mountain => {
        if (explored.has(`${mountain.x},${mountain.y}`)) {
          const x = (mountain.x - cameraX) * CELL_SIZE;
          const y = (mountain.y - cameraY) * CELL_SIZE;

          if (x >= -CELL_SIZE && x < CANVAS_SIZE && y >= -CELL_SIZE && y < CANVAS_SIZE) {
            // Mountain base (dark brown)
            ctx.fillStyle = '#654321';
            ctx.fillRect(x, y, CELL_SIZE, CELL_SIZE);
            
            // Mountain peak (lighter)
            ctx.fillStyle = '#8B7355';
            ctx.beginPath();
            ctx.moveTo(x + CELL_SIZE / 2, y);
            ctx.lineTo(x + CELL_SIZE, y + CELL_SIZE);
            ctx.lineTo(x, y + CELL_SIZE);
            ctx.closePath();
            ctx.fill();
            
            // Snow cap
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(x + CELL_SIZE * 0.4, y, CELL_SIZE * 0.2, CELL_SIZE * 0.2);
          }
        }
      });
    }

    // Draw placed items (buildings)
    if (gameState.placed_items) {
      gameState.placed_items.forEach(item => {
        if (explored.has(`${item.x},${item.y}`)) {
          const x = (item.x - cameraX) * CELL_SIZE;
          const y = (item.y - cameraY) * CELL_SIZE;

          if (x >= -CELL_SIZE && x < CANVAS_SIZE && y >= -CELL_SIZE && y < CANVAS_SIZE) {
            // Special rendering for cropfields (yellow)
            if (item.type === 'cropfield') {
              ctx.fillStyle = '#F4D03F';  // Bright yellow
              ctx.fillRect(x, y, CELL_SIZE, CELL_SIZE);
              
              // Add wheat icon
              ctx.fillStyle = '#DAA520';
              ctx.font = 'bold 12px Arial';
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.fillText('🌾', x + CELL_SIZE / 2, y + CELL_SIZE / 2);
            } else {
              // Normal building rendering
              ctx.fillStyle = 'rgba(139, 69, 19, 0.7)';
              ctx.fillRect(x, y, CELL_SIZE, CELL_SIZE);
              
              // Icon
              ctx.fillStyle = '#FFD700';
              ctx.font = 'bold 16px Arial';
              ctx.textAlign = 'center';
              ctx.textBaseline = 'middle';
              ctx.fillText(item.icon, x + CELL_SIZE / 2, y + CELL_SIZE / 2);
            }
          }
        }
      });
    }

    // Draw Spark (always visible!)
    const sparkX = (spark.x - cameraX) * CELL_SIZE + CELL_SIZE / 2;
    const sparkY = (spark.y - cameraY) * CELL_SIZE + CELL_SIZE / 2;

    if (sparkX >= 0 && sparkX < CANVAS_SIZE && sparkY >= 0 && sparkY < CANVAS_SIZE) {
      const gradient = ctx.createRadialGradient(sparkX, sparkY, 0, sparkX, sparkY, CELL_SIZE * 0.7);
      gradient.addColorStop(0, 'rgba(76, 175, 80, 1)');
      gradient.addColorStop(0.5, 'rgba(76, 175, 80, 0.6)');
      gradient.addColorStop(1, 'rgba(76, 175, 80, 0)');
      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(sparkX, sparkY, CELL_SIZE * 0.7, 0, 2 * Math.PI);
      ctx.fill();

      ctx.fillStyle = '#4CAF50';
      ctx.beginPath();
      ctx.arc(sparkX, sparkY, CELL_SIZE * 0.35, 0, 2 * Math.PI);
      ctx.fill();

      ctx.fillStyle = isDay ? '#1a1a1a' : '#ffffff';
      ctx.beginPath();
      const eyeSize = CELL_SIZE * 0.1;
      ctx.arc(sparkX - CELL_SIZE * 0.15, sparkY - CELL_SIZE * 0.1, eyeSize, 0, 2 * Math.PI);
      ctx.arc(sparkX + CELL_SIZE * 0.15, sparkY - CELL_SIZE * 0.1, eyeSize, 0, 2 * Math.PI);
      ctx.fill();
    }

  }, [gameState]);

  const togglePause = async () => {
    try {
      const response = await axios.post(`${API}/game/toggle-pause`);
      if (response.data.success) {
        setIsPaused(response.data.is_paused);
        console.log(`[GAME] ${response.data.message}`);
      }
    } catch (err) {
      console.error('[GAME] Error toggling pause:', err);
    }
  };

  const handleCanvasClick = async (e) => {
    if (!buildMode || !selectedItem) return;
    
    const canvas = canvasRef.current;
    const rect = canvas.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const clickY = e.clientY - rect.top;
    
    // Convert to grid coordinates
    const gridX = Math.floor(clickX / CELL_SIZE);
    const gridY = Math.floor(clickY / CELL_SIZE);
    
    // Calculate world position (accounting for camera)
    const explored = new Set(gameState.explored_tiles?.map(t => `${t[0]},${t[1]}`) || []);
    let minX = gameState.grid_size, maxX = 0, minY = gameState.grid_size, maxY = 0;
    gameState.explored_tiles?.forEach(([x, y]) => {
      minX = Math.min(minX, x);
      maxX = Math.max(maxX, x);
      minY = Math.min(minY, y);
      maxY = Math.max(maxY, y);
    });
    const cameraX = Math.max(0, Math.min(gameState.grid_size - 40, minX - 5));
    const cameraY = Math.max(0, Math.min(gameState.grid_size - 40, minY - 5));
    
    const worldX = Math.floor(cameraX + gridX);
    const worldY = Math.floor(cameraY + gridY);
    
    console.log(`[BUILD] Placing ${selectedItem.type} at (${worldX}, ${worldY})`);
    
    // Check if player has enough resources
    const cost = selectedItem.cost || {};
    const inv = gameState.spark.inventory;
    
    if (cost.wood && inv.wood < cost.wood) {
      alert(`❌ Niet genoeg hout! Nodig: ${cost.wood}, Je hebt: ${inv.wood}`);
      return;
    }
    if (cost.stone && inv.stone < cost.stone) {
      alert(`❌ Niet genoeg steen! Nodig: ${cost.stone}, Je hebt: ${inv.stone}`);
      return;
    }
    
    try {
      const response = await axios.post(`${API}/game/place-item`, {
        item_type: selectedItem.type,
        x: worldX,
        y: worldY,
        placed_by: 'player'
      });
      
      if (response.data.success) {
        console.log('[BUILD] Item placed successfully!');
        fetchGameState(); // Refresh game state
      } else {
        alert(`❌ ${response.data.message || 'Kon item niet plaatsen'}`);
      }
    } catch (err) {
      console.error('[BUILD] Error placing item:', err);
      alert('❌ Fout bij plaatsen van item');
    }
  };

  const buildableItems = [
    { type: 'house', name: 'Huis', icon: '🏠', cost: { wood: 2, stone: 2 } },
    { type: 'lumberjack', name: 'Houthakker', icon: '🪓', cost: { wood: 10 } },
    { type: 'planter', name: 'Planter', icon: '🌱', cost: { wood: 10 } },
    { type: 'miner', name: 'Miner', icon: '⛏️', cost: { stone: 10 } },
    { type: 'fisher', name: 'Visser', icon: '🎣', cost: { wood: 5 } },
    { type: 'farmer', name: 'Boer', icon: '👨‍🌾', cost: { wood: 8 } },
    { type: 'miller', name: 'Molenaar', icon: '🌾', cost: { wood: 15, stone: 5 } },
    { type: 'baker', name: 'Bakker', icon: '🍞', cost: { wood: 12, stone: 8 } },
    { type: 'sawmill', name: 'Houtzagerij', icon: '🪚', cost: { wood: 20, stone: 10 } },
    { type: 'well', name: 'Waterput', icon: '💧', cost: { stone: 5 } },
    { type: 'runner', name: 'Loopjongen', icon: '🏃', cost: { wood: 3 } },
    { type: 'cropfield', name: 'Akkerveld', icon: '🌾', cost: { wood: 2 } },
    { type: 'warehouse', name: 'Warehouse', icon: '🏭', cost: { wood: 10, stone: 10 } },
    { type: 'wall', name: 'Muur', icon: '🧱', cost: { stone: 1 } },
  ];

  if (loading) {
    return (
      <div className="game-tab">
        <div className="game-loading">
          <div className="spinner"></div>
          <p>Game wordt geladen...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="game-tab">
        <div className="game-error">
          <p>❌ {error}</p>
          <button onClick={fetchGameState}>Opnieuw proberen</button>
        </div>
      </div>
    );
  }
  
  if (!gameState) {
    return <div className="game-loading">⏳ Laden...</div>;
  }

  const { spark, monuments, game_time, stats } = gameState;

  return (
    <div className="game-tab">
      <div className="game-header">
        <h1>🎮 Spark AI Mini Survival Game</h1>
        <div className="game-day-indicator">
          {game_time.is_day ? '☀️' : '🌙'} Dag {game_time.day}
        </div>
      </div>

      <div className="game-container">
        <div className="game-canvas-wrapper">
          {/* Controls ONDER ELKAAR */}
          <div style={{
            display: 'flex', 
            flexDirection: 'column',
            gap: '8px',
            alignItems: 'stretch',
            padding: '12px',
            background: 'linear-gradient(135deg, rgba(26, 35, 47, 0.95), rgba(38, 50, 66, 0.95))',
            borderRadius: '12px',
            marginBottom: '12px',
            border: '2px solid rgba(76, 175, 80, 0.3)',
            boxShadow: '0 4px 12px rgba(0,0,0,0.3)'
          }}>
            {/* Pauze knop */}
            <button 
              onClick={togglePause}
              title={isPaused ? "Start de actieve wereld" : "Pauzeer de wereld"}
              style={{
                padding: '10px 20px',
                borderRadius: '8px',
                border: 'none',
                background: isPaused ? 'linear-gradient(135deg, #4CAF50, #45a049)' : 'linear-gradient(135deg, #FFC107, #ffb300)',
                color: 'white',
                fontWeight: 'bold',
                cursor: 'pointer',
                fontSize: '15px',
                boxShadow: '0 3px 6px rgba(0,0,0,0.2)',
                transition: 'all 0.3s ease'
              }}
            >
              {isPaused ? '▶️ Start Wereld' : '⏸️ Pauzeer'}
            </button>
            
            {/* Status */}
            <span style={{
              color: isPaused ? '#ff6b6b' : '#4CAF50',
              fontWeight: 'bold',
              fontSize: '12px',
              textShadow: '0 2px 4px rgba(0,0,0,0.3)',
              textAlign: 'center'
            }}>
              {isPaused ? '⏸️ Gepauzeerd' : '🌍 Actieve Wereld'}
            </span>
            
            {/* Bouwmodus knop */}
            <button 
              onClick={() => {
                setBuildMode(!buildMode);
                if (buildMode) setSelectedItem(null);
              }}
              style={{
                padding: '10px 20px',
                borderRadius: '8px',
                border: 'none',
                background: buildMode ? 'linear-gradient(135deg, #f44336, #d32f2f)' : 'linear-gradient(135deg, #2196F3, #1976D2)',
                color: 'white',
                fontWeight: 'bold',
                cursor: 'pointer',
                fontSize: '14px',
                boxShadow: '0 3px 6px rgba(0,0,0,0.2)',
                transition: 'all 0.3s ease'
              }}
            >
              {buildMode ? '❌ Annuleer' : '🏗️ Bouwmodus'}
            </button>
          </div>
          
          {/* Canvas */}
          <canvas 
            ref={canvasRef}
            id="game-canvas" 
            width={CANVAS_SIZE} 
            height={CANVAS_SIZE}
            tabIndex={0}
            style={{ cursor: buildMode ? 'crosshair' : 'default', outline: 'none' }}
            onClick={handleCanvasClick}
          />
        </div>

        <div className="game-stats">
            
            {buildMode && (
              <div className="build-items">
                <div className="build-items-title">Selecteer item:</div>
                {buildableItems.map(item => {
                  const canAfford = (!item.cost.wood || gameState.spark.inventory.wood >= item.cost.wood) &&
                                   (!item.cost.stone || gameState.spark.inventory.stone >= item.cost.stone);
                  
                  return (
                    <button
                      key={item.type}
                      className={`build-item ${selectedItem?.type === item.type ? 'selected' : ''} ${!canAfford ? 'disabled' : ''}`}
                      onClick={() => setSelectedItem(item)}
                      disabled={!canAfford}
                      title={`${item.name} - Kost: ${item.cost.wood || 0}🪵 ${item.cost.stone || 0}🪨`}
                    >
                      <div className="build-item-icon">{item.icon}</div>
                      <div className="build-item-name">{item.name}</div>
                      <div className="build-item-cost">
                        {item.cost.wood > 0 && <span>🪵{item.cost.wood}</span>}
                        {item.cost.stone > 0 && <span>🪨{item.cost.stone}</span>}
                      </div>
                    </button>
                  );
                })}
              </div>
            )}
          </div>
        </div>
        
        {/* Right Sidebar - Stats */}
        <div className="game-stats">
          <div className="needs-section">
            <h3>🎯 Basis Behoeften</h3>
            
            <div className="need-bar">
              <span className="need-label">🍖 Eten:</span>
              <div className="bar-container">
                <div 
                  className="bar-fill hunger" 
                  style={{ width: `${spark.hunger}%` }}
                />
              </div>
              <span className="need-value">{Math.round(spark.hunger)}%</span>
            </div>

            <div className="need-bar">
              <span className="need-label">💧 Drinken:</span>
              <div className="bar-container">
                <div 
                  className="bar-fill thirst" 
                  style={{ width: `${spark.thirst}%` }}
                />
              </div>
              <span className="need-value">{Math.round(spark.thirst)}%</span>
            </div>
          </div>

          <div className="inventory-section">
            <h3>🎒 Inventaris</h3>
            <div className="stat-item">
              <span className="stat-label">🪵 Hout:</span>
              <span className="stat-value">{spark.inventory.wood}</span>
            </div>
            <div className="stat-item">
              <span className="stat-label">🪨 Steen:</span>
              <span className="stat-value">{spark.inventory.stone}</span>
            </div>
            <div className="stat-item">
              <span className="stat-label">🐟 Vis:</span>
              <span className="stat-value">{spark.inventory.fish}</span>
            </div>
            <div className="stat-item">
              <span className="stat-label">🍶 Waterfles:</span>
              <span className="stat-value">{spark.inventory.water_bottle}</span>
            </div>
          </div>

          <div className="items-section">
            <h3>🎒 Items</h3>
            <div className="items-grid">
              {spark.items && spark.items.map(item => (
                <div key={item} className="item-badge">
                  {gameState.items_data?.[item]?.icon || '📦'} {gameState.items_data?.[item]?.name || item}
                </div>
              ))}
              
              {spark.inventory.water_bottle > 0 && (
                <div className="item-badge consumable">
                  🍶 Waterfles <span className="item-count">x{spark.inventory.water_bottle}</span>
                </div>
              )}
              {spark.inventory.fish > 0 && (
                <div className="item-badge consumable">
                  🐟 Vis <span className="item-count">x{spark.inventory.fish}</span>
                </div>
              )}
            </div>
          </div>

          <div className="monument-section">
            <h3>🏛️ Monumenten (5)</h3>
            {gameState.monuments && gameState.monuments.slice(0, 3).map(monument => (
              <div key={monument.id} className="monument-item">
                <div className="monument-header">
                  <span>{monument.icon} {monument.name}</span>
                  <span className="monument-percent">{monument.progress.toFixed(1)}%</span>
                </div>
                <div className="progress-bar-container small">
                  <div 
                    className="progress-bar-fill" 
                    style={{ width: `${monument.progress}%`, background: monument.color }}
                  />
                </div>
              </div>
            ))}
          </div>

          <div className="general-stats">
            <h3>📊 Stats</h3>
            <div className="stat-item">
              <span className="stat-label">⚡ Positie:</span>
              <span className="stat-value">({spark.x}, {spark.y})</span>
            </div>
            <div className="stat-item">
              <span className="stat-label">👣 Afstand:</span>
              <span className="stat-value">{stats.distance_traveled} stappen</span>
            </div>
            <div className="stat-item">
              <span className="stat-label">🗺️ Verkend:</span>
              <span className="stat-value">{gameState.explored_tiles?.length || 0} tiles</span>
            </div>
          </div>

          {/* Bewoners Section */}
          {gameState.residents && gameState.residents.length > 0 && (
            <div className="residents-section">
              <h3>👷 Bewoners ({gameState.residents.length})</h3>
              {gameState.residents.map(resident => (
                <div key={resident.id} className="resident-item">
                  <div className="resident-name">{resident.name}</div>
                  <div className="resident-profession">
                    {resident.profession === 'lumberjack' && '🪓 Houthakker'}
                    {resident.profession === 'planter' && '🌱 Planter'}
                    {resident.profession === 'miner' && '⛏️ Miner'}
                    {resident.profession === 'fisher' && '🎣 Visser'}
                    {resident.profession === 'farmer' && '👨‍🌾 Boer'}
                    {resident.profession === 'miller' && '🌾 Molenaar'}
                    {resident.profession === 'baker' && '🍞 Bakker'}
                    {resident.profession === 'sawmill' && '🪚 Houtzagerij'}
                    {resident.profession === 'runner' && '🏃 Loopjongen'}
                  </div>
                  <div className="resident-status">
                    {resident.status === 'waiting_for_house' && (
                      <span className="status-warning">⚠️ Heeft huis nodig!</span>
                    )}
                    {resident.status === 'ready_to_work' && (
                      <span className="status-ready">✅ Klaar om te werken</span>
                    )}
                  </div>
                  <div className="resident-needs">
                    <span>🍖 {Math.round(resident.hunger)}%</span>
                    <span>💧 {Math.round(resident.thirst)}%</span>
                  </div>
                </div>
              ))}
            </div>
          )}

          {/* Warehouse Storage */}
          {gameState.placed_items && gameState.placed_items.some(p => p.type === 'warehouse') && (
            <div className="warehouse-section">
              <h3>🏭 Warehouse Opslag</h3>
              {gameState.placed_items.filter(p => p.type === 'warehouse').map(warehouse => {
                const storage = warehouse.storage || { wood: 0, stone: 0, fish: 0, food: 0, grain: 0, flour: 0, bread: 0, plank: 0, water: 0 };
                return (
                  <div key={warehouse.id} className="warehouse-storage">
                    <div className="storage-item">🪵 Hout: <strong>{storage.wood}</strong></div>
                    <div className="storage-item">🪨 Steen: <strong>{storage.stone}</strong></div>
                    <div className="storage-item">🐟 Vis: <strong>{storage.fish}</strong></div>
                    <div className="storage-item">🍖 Food: <strong>{storage.food}</strong></div>
                    <div className="storage-item">🌾 Graan: <strong>{storage.grain}</strong></div>
                    <div className="storage-item">🥖 Meel: <strong>{storage.flour}</strong></div>
                    <div className="storage-item">🍞 Brood: <strong>{storage.bread}</strong></div>
                    <div className="storage-item">🪵 Planken: <strong>{storage.plank}</strong></div>
                    <div className="storage-item">💧 Water: <strong>{storage.water}</strong></div>
                  </div>
                );
              })}
            </div>
          )}

          <div className="game-info">
            <h4>ℹ️ Fase 3 - Fog of War</h4>
            <ul>
              <li>🗺️ Verken de wereld</li>
              <li>🌑 Fog of war actief</li>
              <li>📹 Camera volgt Spark</li>
              <li>🎯 Vision radius: 5 tiles</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  );
}

export default GameTab;
